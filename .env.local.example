# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 이미지 생성 provider: Cloudflare Workers AI (FLUX)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 생성된 이미지 저장: Cloudflare R2 (S3 호환 API 전용 토큰 — 위 CLOUDFLARE_API_TOKEN과 별개)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
# 버킷 공개 접근 URL (r2.dev 공개 URL 또는 연결한 커스텀 도메인)
R2_PUBLIC_URL=

# 이미지 생성 기능 on/off 킬스위치 (무료 뉴런 한도 절약용). true일 때만 실제로 생성된다.
IMAGE_GENERATION_ENABLED=false

# /admin 접근용 임시 비밀번호 (계정 시스템이 없어 공유 비밀 하나로만 게이팅)
ADMIN_SECRET=

# Google AdSense 리워드 광고 (ca-pub-... 형식). 승인 전에는 주석 처리 —
# 값이 없으면 리워드 광고 버튼이 비활성 상태로 표시된다.
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# robots.txt/sitemap.xml에 쓰이는 실제 배포 도메인 (예: https://balancelab.kr).
# 비워두면 Vercel 배포 URL이나 localhost로 대체된다.
NEXT_PUBLIC_SITE_URL=
